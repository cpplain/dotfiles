{
  "env": {
    "CLAUDE_CODE_DISABLE_1M_CONTEXT": "1",
    "DISABLE_AUTOUPDATER": "1",
    "ENABLE_LSP_TOOL": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": ["WebSearch"],
    "deny": ["AskUserQuestion"]
  },
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "lsp-config@my-plugins": true
  },
  "extraKnownMarketplaces": {
    "my-plugins": {
      "source": {
        "source": "directory",
        "path": "/Users/christopherplain/git/dotfiles/plugins"
      }
    }
  },
  "effortLevel": "medium",
  "plansDirectory": ".claude/plans",
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto"
}
