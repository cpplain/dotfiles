{
  "env": {
    "CLAUDE_CODE_DISABLE_1M_CONTEXT": "1",
    "DISABLE_AUTOUPDATER": "1",
    "ENABLE_LSP_TOOL": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": ["WebSearch"],
    "deny": ["AskUserQuestion"]
  },
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "lsp-config@my-plugins": true
  },
  "extraKnownMarketplaces": {
    "my-plugins": {
      "source": {
        "source": "directory",
        "path": "/Users/christopherplain/git/dotfiles/plugins"
      }
    }
  },
  "skillOverrides": {
    "anthropic-skills:deep-research": "user-invocable-only",
    "anthropic-skills:skill-creator": "off",
    "anthropic-skills:docs": "off",
    "anthropic-skills:morning": "user-invocable-only",
    "anthropic-skills:computer-use": "user-invocable-only",
    "anthropic-skills:chrome-browser": "user-invocable-only",
    "anthropic-skills:built-in-browser": "user-invocable-only",
    "anthropic-skills:docx": "user-invocable-only",
    "anthropic-skills:pptx": "user-invocable-only",
    "anthropic-skills:xlsx": "user-invocable-only",
    "anthropic-skills:pdf": "user-invocable-only",
    "claude-in-chrome": "user-invocable-only",
    "skill-builder": "user-invocable-only",
    "keybindings-help": "user-invocable-only",
    "fewer-permission-prompts": "user-invocable-only",
    "loop": "user-invocable-only",
    "schedule": "user-invocable-only",
    "init": "user-invocable-only",
    "security-review": "user-invocable-only",
    "code-review": "user-invocable-only",
    "simplify": "user-invocable-only",
    "run": "user-invocable-only",
    "plugin-authoring": "user-invocable-only",
    "dataviz": "name-only",
    "claude-api": "name-only",
    "artifact-diagramming": "name-only",
    "workflow-authoring": "name-only"
  },
  "effortLevel": "medium",
  "plansDirectory": ".claude/plans",
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto"
}
