#!/usr/bin/env zsh
# File-level symlink manager for this dotfiles repo.
#
# Manifest (`links`): whitespace-separated
#   source  target  [when:personal|when:work]
# A trailing slash, or an existing directory, expands to one link per
# regular file. The path under source is appended to target.
# An explicit file row overrides the walk for that source even when
# the row is skipped by when:.
# adopt dest is relative to the source's target, not ~. A <src> not yet in
# the manifest gets a new directory row; its target defaults to the adopted
# directory, or the common parent of the adopted files.
# adopt checks every file before moving any of them.
#
# create classifies every planned target, then applies only if none fail.
# An existing symlink is replaced only when it already points into this repo.
# create does not remove leftovers.
#
# status leftover = symlink into this repo that is not in the current plan
# (deleted source, or when: no longer matches). Found via last-plan plus a
# scoped scan: ancestors of planned and last-plan targets, non-home siblings
# of those dirs. It does not walk all of $HOME. share/cache/state/Library/
# .Trash are skipped. last-plan is $HOME/.local/state/dotlink/last-plan.
# prune also removes directories it leaves empty (ignoring .DS_Store),
# never $HOME itself.

# Usage: scripts/link create|status|adopt|prune [flags] [args]

set -euo pipefail
setopt EXTENDED_GLOB

REPO=${LINK_ROOT:-${0:A:h:h}}
MANIFEST=${LINK_MANIFEST:-$REPO/links}
HOME_DIR=${LINK_HOME:-$HOME}
ENV_FILE=${LINK_ENV:-$HOME_DIR/.dotfilesenv}
STATE=${LINK_STATE:-$HOME_DIR/.local/state/dotlink/last-plan}

PROG=${0:t}

typeset -g DOTFILES_ENV=""
typeset -g DRY_RUN=0
typeset -g ENV_WARNED=0
typeset -g SHOW_ALL=0
typeset -g OPT_TARGET=""
typeset -g OPT_WHEN=""
typeset -g OPT_YES=0
typeset -g PLAN_QUIET=0

typeset -a PLAN_SRC PLAN_TGT
typeset -a MAN_SRC MAN_TGT MAN_WHEN MAN_KIND
typeset -a LEFTOVER

usage() {
    cat <<EOF
Usage: $PROG <command> [flags] [args]

Commands:
  create              Create symlinks from the links manifest.
                      Applies nothing if any target is a regular file
                      or a symlink that does not already point into this repo.
  status [-a]         Show problems and leftover repo-pointing symlinks.
                      Lines: ok, missing, wrong, broken, nosource, leftover.
                      ok lines are shown only with -a.
                      leftover = points into the repo but is not in the plan.
                      Exits 1 when any planned row is not ok or a leftover exists.
  adopt <src> <path>...
                      Move files into repo source <src> and link them back.
                      A directory <path> adopts every regular file under it.
                      Dest is relative to <src>'s target, not ~.
                      Example: adopt git ~/.config/git/config stores git/config.
                      If <src> is not in links, a row is added for it:
                        -t, --target <dir>   target (default: the directory
                                             adopted, or the files' parent)
                        -w, --when <env>     personal or work
                      Files under another source's target are skipped.
                      More than 20 files asks for confirmation:
                        -y, --yes            skip the confirmation
                      <path>: absolute, ~/, or relative to PWD.
  prune               Remove leftover repo-pointing symlinks and the
                      directories they leave empty. Does not touch
                      planned broken or wrong rows.

Flags:
  -n, --dry-run       Preview changes without making them
  -h, --help          Show this help
  --                  End of flags
EOF
}

err() {
    print -u2 "error: $*"
}

warn() {
    print -u2 "warning: $*"
}

die() {
    err "$@"
    exit 1
}

expand_tilde() {
    local p=$1
    case $p in
        '~')  print -r -- "$HOME_DIR" ;;
        '~/'*) print -r -- "$HOME_DIR/${p#'~/'}" ;;
        *)    print -r -- "$p" ;;
    esac
}

abs_path() {
    local p
    p=$(expand_tilde "$1")
    if [[ $p == /* ]]; then
        print -r -- "$p"
    else
        print -r -- "$REPO/$p"
    fi
}

# Repo-relative source spec. Accepts repo-relative, ./, ~/, or an absolute
# path inside the repo; strips trailing slashes.
normalize_src() {
    local s
    s=$(expand_tilde "$1")
    if [[ $s == /* ]]; then
        s=${s:a}
        [[ $s == $REPO/* ]] && s=${s#$REPO/}
    fi
    s=${s#./}
    s=${s%%/#}
    print -r -- "$s"
}

# Absolute path of a symlink's target without requiring the target to exist.
resolve_link() {
    local link=$1
    local raw
    raw=$(readlink "$link") || return 1
    if [[ $raw != /* ]]; then
        raw="${link:h}/$raw"
    fi
    print -r -- "${raw:a}"
}

is_repo_path() {
    local p=$1
    [[ $p == $REPO || $p == $REPO/* ]]
}

is_scan_skip_name() {
    [[ $1 == Library || $1 == .Trash || $1 == share || $1 == cache || $1 == state ]]
}

# Home-file path for adopt: ~/ , absolute, or relative to PWD. Not repo-relative.
resolve_home_file() {
    local p
    p=$(expand_tilde "$1")
    if [[ $p != /* ]]; then
        p=$PWD/$p
    fi
    print -r -- "${p:a}"
}

mark_hot_ancestors() {
    local tgt=$1
    local d=$tgt
    while true; do
        d=${d:h}
        [[ $d == $HOME_DIR || $d == $HOME_DIR/* ]] || break
        HOT_DIR[$d]=1
        [[ $d == $HOME_DIR ]] && break
    done
}

write_last_plan() {
    typeset -A keep
    local t dest
    for t in $PLAN_TGT; do
        keep[$t]=1
    done
    if [[ -f $STATE ]]; then
        while IFS= read -r t || [[ -n $t ]]; do
            [[ -n $t ]] || continue
            [[ -n ${keep[$t]:-} ]] && continue
            [[ -L $t ]] || continue
            dest=$(resolve_link "$t") || continue
            is_repo_path "$dest" || continue
            keep[$t]=1
        done <"$STATE"
    fi
    mkdir -p -- "${STATE:h}"
    {
        for t in ${(ko)keep}; do
            print -r -- "$t"
        done
    } >"$STATE"
}

load_env() {
    DOTFILES_ENV=""
    if [[ -f $ENV_FILE ]]; then
        DOTFILES_ENV=$(<"$ENV_FILE")
        DOTFILES_ENV=${DOTFILES_ENV%%$'\n'*}
        DOTFILES_ENV=${DOTFILES_ENV%%[[:space:]]#}
        DOTFILES_ENV=${DOTFILES_ENV##[[:space:]]#}
        if [[ $DOTFILES_ENV != personal && $DOTFILES_ENV != work ]]; then
            if (( ! ENV_WARNED )); then
                warn "ignoring invalid $ENV_FILE value ${(q)DOTFILES_ENV}; applying unguarded rows only"
                ENV_WARNED=1
            fi
            DOTFILES_ENV=""
        fi
    elif (( ! ENV_WARNED )); then
        warn "no $ENV_FILE; applying unguarded rows only"
        ENV_WARNED=1
    fi
}

profile_matches() {
    local when=$1
    [[ -z $when ]] && return 0
    [[ -n $DOTFILES_ENV && $when == $DOTFILES_ENV ]] && return 0
    return 1
}

should_skip() {
    local rel=$1
    local base=${rel:t}
    [[ $base == .DS_Store || $base == *.swp || $base == *.tmp ]] && return 0
    [[ $rel == .git || $rel == .git/* || $rel == */.git || $rel == */.git/* ]] && return 0
    return 1
}

# Sets REPLY to "dir" or "file".
row_kind() {
    local spec=$1
    local abs
    if [[ $spec == */ ]]; then
        REPLY=dir
        return
    fi
    abs=$(abs_path "$spec")
    if [[ -d $abs ]]; then
        REPLY=dir
    else
        REPLY=file
    fi
}

parse_manifest() {
    MAN_SRC=()
    MAN_TGT=()
    MAN_WHEN=()
    MAN_KIND=()

    [[ -f $MANIFEST ]] || die "manifest not found: $MANIFEST"

    local line src tgt when field rest kind
    local -i lineno=0
    while IFS= read -r line || [[ -n $line ]]; do
        lineno+=1
        line=${line%%\#*}
        line=${line##[[:space:]]#}
        line=${line%%[[:space:]]#}
        [[ -z $line ]] && continue

        src=${line%%[[:space:]]*}
        rest=${line#${src}}
        rest=${rest##[[:space:]]#}
        [[ -n $rest ]] || die "$MANIFEST:$lineno: missing target"

        tgt=${rest%%[[:space:]]*}
        rest=${rest#${tgt}}
        rest=${rest##[[:space:]]#}

        when=""
        if [[ -n $rest ]]; then
            field=${rest%%[[:space:]]*}
            rest=${rest#${field}}
            rest=${rest##[[:space:]]#}
            [[ -z $rest ]] || die "$MANIFEST:$lineno: unexpected extra field"
            if [[ $field == when:* ]]; then
                when=${field#when:}
            else
                die "$MANIFEST:$lineno: invalid field ${(q)field} (expected when:personal or when:work)"
            fi
            if [[ $when != personal && $when != work ]]; then
                die "$MANIFEST:$lineno: invalid when:${when} (expected personal or work)"
            fi
        fi

        row_kind "$src"
        kind=$REPLY

        MAN_SRC+=("$src")
        MAN_TGT+=("$tgt")
        MAN_WHEN+=("$when")
        MAN_KIND+=("$kind")
    done <"$MANIFEST"
}

collect_dir_files() {
    local abs_src=$1
    local -a files
    files=()
    # -type f: regular files only (not dirs, not symlinks)
    while IFS= read -r f; do
        [[ -n $f ]] && files+=("$f")
    done < <(find "$abs_src" \( -name .git -type d -prune \) -o -type f -print | sort)

    REPLY_FILES=("${files[@]}")
}

# $1 = 1 to keep missing explicit sources in the plan (status); 0 to skip (create).
build_plan() {
    local include_missing=${1:-0}
    PLAN_SRC=()
    PLAN_TGT=()
    load_env
    parse_manifest

    typeset -A explicit_src
    explicit_src=()

    local i src tgt when kind abs_src abs_tgt rel dest
    local -a files
    typeset -g -a REPLY_FILES

    for (( i = 1; i <= $#MAN_SRC; i++ )); do
        src=$MAN_SRC[i]
        tgt=$MAN_TGT[i]
        when=$MAN_WHEN[i]
        kind=$MAN_KIND[i]
        [[ $kind == dir ]] || continue
        profile_matches "$when" || continue

        abs_src=$(abs_path "${src%/}")
        if [[ ! -d $abs_src ]]; then
            (( PLAN_QUIET )) || warn "skipping missing source directory ${src%/}"
            continue
        fi

        abs_tgt=$(abs_path "$tgt")
        abs_tgt=${abs_tgt%/}
        collect_dir_files "$abs_src"
        files=("${REPLY_FILES[@]}")

        for f in "${files[@]}"; do
            rel=${f#${abs_src}/}
            should_skip "$rel" && continue
            dest=$abs_tgt/$rel
            PLAN_SRC+=("$f")
            PLAN_TGT+=("$dest")
        done
    done

    # Record explicit sources so they override walked identity pairs,
    # even when the explicit row is skipped by when:.
    local -a keep_src keep_tgt
    for (( i = 1; i <= $#MAN_SRC; i++ )); do
        [[ $MAN_KIND[i] == file ]] || continue
        abs_src=$(abs_path "${MAN_SRC[i]%/}")
        explicit_src[$abs_src]=1
    done

    keep_src=()
    keep_tgt=()
    for (( i = 1; i <= $#PLAN_SRC; i++ )); do
        if [[ -n ${explicit_src[$PLAN_SRC[i]]:-} ]]; then
            continue
        fi
        keep_src+=("$PLAN_SRC[i]")
        keep_tgt+=("$PLAN_TGT[i]")
    done
    PLAN_SRC=("${keep_src[@]}")
    PLAN_TGT=("${keep_tgt[@]}")

    for (( i = 1; i <= $#MAN_SRC; i++ )); do
        [[ $MAN_KIND[i] == file ]] || continue
        profile_matches "$MAN_WHEN[i]" || continue
        abs_src=$(abs_path "${MAN_SRC[i]%/}")
        abs_tgt=$(abs_path "$MAN_TGT[i]")
        if [[ ! -f $abs_src ]]; then
            if (( ! include_missing )); then
                (( PLAN_QUIET )) || warn "skipping missing source file ${MAN_SRC[i]}"
                continue
            fi
        fi
        PLAN_SRC+=("$abs_src")
        PLAN_TGT+=("$abs_tgt")
    done

    typeset -A seen_tgt
    seen_tgt=()
    for (( i = 1; i <= $#PLAN_TGT; i++ )); do
        dest=$PLAN_TGT[i]
        if [[ -n ${seen_tgt[$dest]:-} ]]; then
            die "two sources map to $dest:\n  ${seen_tgt[$dest]}\n  $PLAN_SRC[i]"
        fi
        seen_tgt[$dest]=$PLAN_SRC[i]
    done
}

display_path() {
    local p=$1
    if [[ $p == $HOME_DIR || $p == $HOME_DIR/* ]]; then
        print -r -- "~${p#$HOME_DIR}"
    else
        print -r -- "$p"
    fi
}

# Sets REPLY to skip, create, replace, or fail.
classify_one() {
    local src=$1 tgt=$2
    local existing resolved

    if [[ -L $tgt ]]; then
        existing=$(readlink "$tgt")
        resolved=$(resolve_link "$tgt") || resolved=""
        if [[ $existing == $src || $resolved == $src || $resolved == ${src:a} ]]; then
            REPLY=skip
            return 0
        fi
        if [[ -n $resolved ]] && is_repo_path "$resolved"; then
            REPLY=replace
            return 0
        fi
        err "$(display_path "$tgt"): unmanaged symlink (does not point into the repo)"
        print -u2 "  -> $(display_path "${resolved:-$existing}"); remove it to link ${src#$REPO/}"
        REPLY=fail
        return 0
    elif [[ -e $tgt ]]; then
        err "$(display_path "$tgt"): already exists and is not a symlink"
        print -u2 "  compare with ${src#$REPO/}, then move it aside and rerun create"
        REPLY=fail
        return 0
    fi

    REPLY=create
    return 0
}

apply_one() {
    local src=$1 tgt=$2 action=$3
    local parent=${tgt:h}

    if (( DRY_RUN )); then
        if [[ $action == replace ]]; then
            print "would replace $(display_path "$tgt") -> $(display_path "$src")"
        else
            print "would link $(display_path "$tgt") -> $(display_path "$src")"
        fi
        return 0
    fi

    if [[ $action == replace ]]; then
        rm -- "$tgt"
    fi
    mkdir -p -- "$parent"
    ln -s -- "$src" "$tgt"
    if [[ $action == replace ]]; then
        print "replaced $(display_path "$tgt") -> $(display_path "$src")"
    else
        print "created $(display_path "$tgt") -> $(display_path "$src")"
    fi
}

report_leftovers() {
    collect_leftovers
    if (( $#LEFTOVER )); then
        print "$#LEFTOVER leftover(s); run '$PROG prune' to remove them"
    fi
}

cmd_create() {
    (( $# == 0 )) || die "create takes no arguments"
    build_plan 0

    if (( $#PLAN_SRC == 0 )); then
        print "no files to link"
        report_leftovers
        return 0
    fi

    local i
    local -a act
    local -i created=0 replaced=0 skipped=0 failed=0
    act=()
    for (( i = 1; i <= $#PLAN_SRC; i++ )); do
        classify_one "$PLAN_SRC[i]" "$PLAN_TGT[i]"
        act[i]=$REPLY
        if [[ $REPLY == fail ]]; then
            failed+=1
        fi
    done

    if (( failed )); then
        print "refusing to create: $failed target(s) blocked"
        return 1
    fi

    for (( i = 1; i <= $#PLAN_SRC; i++ )); do
        case $act[i] in
            skip) skipped+=1 ;;
            create)
                apply_one "$PLAN_SRC[i]" "$PLAN_TGT[i]" create
                created+=1
                ;;
            replace)
                apply_one "$PLAN_SRC[i]" "$PLAN_TGT[i]" replace
                replaced+=1
                ;;
        esac
    done

    if (( DRY_RUN )); then
        print "dry-run: $created to create, $replaced to replace, $skipped already linked"
    else
        write_last_plan
        print "created $created, replaced $replaced, skipped $skipped"
    fi
    report_leftovers
    return 0
}

link_points_at_src() {
    local tgt=$1 src=$2
    local existing resolved
    existing=$(readlink "$tgt")
    resolved=$(resolve_link "$tgt") || resolved=""
    [[ $existing == $src || $resolved == $src || $resolved == ${src:a} ]]
}

consider_leftover() {
    local entry=$1
    local dest
    [[ -n ${PLANNED_TGT[$entry]:-} ]] && return 0
    [[ -n ${SEEN_LEFTOVER[$entry]:-} ]] && return 0
    dest=$(resolve_link "$entry") || return 0
    is_repo_path "$dest" || return 0
    SEEN_LEFTOVER[$entry]=1
    LEFTOVER+=("$entry")
}

collect_find_links() {
    local dir=$1
    local f
    while IFS= read -r f; do
        [[ -n $f ]] && consider_leftover "$f"
    done < <(find "$dir" \
        \( -name Library -type d -prune \) -o \
        \( -name .Trash -type d -prune \) -o \
        \( -name share -type d -prune \) -o \
        \( -name cache -type d -prune \) -o \
        \( -name state -type d -prune \) -o \
        -type l -print 2>/dev/null)
}

scan_leftover_dir() {
    local dir=$1
    local at_home=0
    [[ $dir == $HOME_DIR ]] && at_home=1

    local -a entries
    entries=()
    entries=($dir/*(DN)) 2>/dev/null || return 0

    local entry name
    for entry in $entries; do
        name=${entry:t}
        is_scan_skip_name "$name" && continue
        if [[ $entry == $REPO || $entry == $REPO/* ]]; then
            continue
        fi

        if [[ -L $entry ]]; then
            consider_leftover "$entry"
        elif [[ -d $entry ]]; then
            if [[ -n ${HOT_DIR[$entry]:-} ]]; then
                scan_leftover_dir "$entry"
            elif (( ! at_home )); then
                collect_find_links "$entry"
            fi
        fi
    done
}

collect_leftovers() {
    LEFTOVER=()
    typeset -g -A PLANNED_TGT HOT_DIR SEEN_LEFTOVER
    PLANNED_TGT=()
    HOT_DIR=()
    SEEN_LEFTOVER=()

    local i tgt
    HOT_DIR[$HOME_DIR]=1
    for (( i = 1; i <= $#PLAN_TGT; i++ )); do
        tgt=$PLAN_TGT[i]
        PLANNED_TGT[$tgt]=1
        mark_hot_ancestors "$tgt"
    done

    if [[ -f $STATE ]]; then
        while IFS= read -r tgt || [[ -n $tgt ]]; do
            [[ -n $tgt ]] || continue
            [[ $tgt == $HOME_DIR || $tgt == $HOME_DIR/* ]] || continue
            if [[ -z ${PLANNED_TGT[$tgt]:-} ]]; then
                consider_leftover "$tgt"
            fi
            mark_hot_ancestors "$tgt"
        done <"$STATE"
    fi

    scan_leftover_dir "$HOME_DIR"

    if (( $#LEFTOVER > 1 )); then
        local -a sorted
        sorted=("${(@o)LEFTOVER}")
        LEFTOVER=("${sorted[@]}")
    fi
}

status_line() {
    printf '%-7s %s\n' "$1" "$2"
}

# What occupies a wrong target, for status.
wrong_detail() {
    local tgt=$1
    if [[ -L $tgt ]]; then
        print -r -- "(-> $(display_path "$(readlink "$tgt")"))"
    elif [[ -d $tgt ]]; then
        print -r -- "(directory)"
    else
        print -r -- "(regular file)"
    fi
}

cmd_status() {
    (( $# == 0 )) || die "status takes no arguments"
    build_plan 1
    collect_leftovers

    print "profile: ${DOTFILES_ENV:-none}"
    if (( $#PLAN_SRC == 0 && $#LEFTOVER == 0 )); then
        print "no planned links"
        return 0
    fi

    local i src tgt
    local -i ok=0 missing=0 wrong=0 broken=0 nosource=0 leftover=0

    for (( i = 1; i <= $#PLAN_SRC; i++ )); do
        src=$PLAN_SRC[i]
        tgt=$PLAN_TGT[i]
        if [[ -L $tgt ]] && link_points_at_src "$tgt" "$src"; then
            if [[ -e $src ]]; then
                (( SHOW_ALL )) && status_line ok "$(display_path "$tgt")"
                ok+=1
            else
                status_line broken "$(display_path "$tgt")"
                broken+=1
            fi
        elif [[ ! -e $src ]]; then
            status_line nosource "$(display_path "$tgt") (src missing: ${src#$REPO/})"
            nosource+=1
        elif [[ -L $tgt || -e $tgt ]]; then
            status_line wrong "$(display_path "$tgt") $(wrong_detail "$tgt")"
            wrong+=1
        else
            status_line missing "$(display_path "$tgt")"
            missing+=1
        fi
    done

    for tgt in $LEFTOVER; do
        status_line leftover "$(display_path "$tgt")"
        leftover+=1
    done

    print "\n$ok ok, $missing missing, $wrong wrong, $broken broken, $nosource nosource, $leftover leftover"
    (( missing == 0 && wrong == 0 && broken == 0 && nosource == 0 && leftover == 0 ))
}

# Sets REPLY_DIRS to the directories under $HOME_DIR that removing
# $LEFTOVER would leave empty (ignoring .DS_Store), deepest first.
plan_empty_dirs() {
    typeset -A gone cand
    local t d e
    local -a entries sorted
    REPLY_DIRS=()

    for t in $LEFTOVER; do
        gone[$t]=1
        d=${t:h}
        while [[ $d == $HOME_DIR/* ]]; do
            cand[$d]=1
            d=${d:h}
        done
    done
    (( $#cand )) || return 0

    # A child path is always longer than its parent.
    sorted=("${(@f)$(print -rl -- ${(k)cand} | awk '{ print length($0) "\t" $0 }' | sort -rn | cut -f2-)}")

    for d in $sorted; do
        [[ -d $d && ! -L $d ]] || continue
        entries=($d/*(DN))
        for e in $entries; do
            [[ -n ${gone[$e]:-} || ${e:t} == .DS_Store ]] && continue
            continue 2
        done
        gone[$d]=1
        REPLY_DIRS+=("$d")
    done
}

cmd_prune() {
    (( $# == 0 )) || die "prune takes no arguments"
    build_plan 1
    collect_leftovers

    if (( $#LEFTOVER == 0 )); then
        print "no leftovers"
        return 0
    fi

    typeset -g -a REPLY_DIRS
    plan_empty_dirs
    local -a dirs
    dirs=("${REPLY_DIRS[@]}")

    local tgt d
    if (( DRY_RUN )); then
        for tgt in $LEFTOVER; do
            print "would remove $(display_path "$tgt")"
        done
        for d in $dirs; do
            print "would remove dir $(display_path "$d")/"
        done
        print "dry-run: $#LEFTOVER leftover(s), $#dirs empty dir(s)"
        return 0
    fi

    for tgt in $LEFTOVER; do
        rm -- "$tgt"
        print "removed $(display_path "$tgt")"
    done
    for d in $dirs; do
        rm -f -- "$d/.DS_Store"
        rmdir -- "$d"
        print "removed dir $(display_path "$d")/"
    done
    write_last_plan
    print "removed $#LEFTOVER leftover(s), $#dirs empty dir(s)"
    return 0
}

# Looks up a normalized source spec in the parsed manifest.
# Sets REPLY (absolute target) and REPLY_WHEN for a directory row.
# Returns 1 if the source is not in the manifest, 2 if it is only a file row.
# Dies if the same source maps to two different targets.
manifest_find_src() {
    local want=$1
    local i spec t
    local found="" found_when=""
    local -i file_row=0
    for (( i = 1; i <= $#MAN_SRC; i++ )); do
        spec=$(normalize_src "$MAN_SRC[i]")
        [[ $spec == $want ]] || continue
        if [[ $MAN_KIND[i] != dir ]]; then
            file_row=1
            continue
        fi
        t=$(abs_path "$MAN_TGT[i]")
        t=${t%/}
        if [[ -n $found && ( $found != $t || $found_when != $MAN_WHEN[i] ) ]]; then
            die "$want maps to multiple targets in $MANIFEST"
        fi
        found=$t
        found_when=$MAN_WHEN[i]
    done
    if [[ -n $found ]]; then
        REPLY=$found
        REPLY_WHEN=$found_when
        return 0
    fi
    (( file_row )) && return 2
    return 1
}

# Inserts a directory row into the manifest. Unguarded rows go into the
# first block in sorted order; when: rows go at the end of the block under
# a matching "# <env>" header, which is created if missing.
manifest_add_row() {
    local src=$1 tgt=$2 when=$3
    local row
    row=$(printf '%-36s %s' "$src" "$tgt")
    [[ -n $when ]] && row+=" when:$when"

    local -a lines
    lines=("${(@f)$(<"$MANIFEST")}")
    local -i i n=$#lines at=0 start=0
    local line field

    if [[ -z $when ]]; then
        for (( i = 1; i <= n; i++ )); do
            line=${lines[i]##[[:space:]]#}
            if [[ -z $line || $line == \#* ]]; then
                (( start )) && break
                continue
            fi
            (( start )) || start=i
            field=${line%%[[:space:]]*}
            if [[ $src < $field ]]; then
                at=i
                break
            fi
        done
        (( at )) || at=$(( start ? i : n + 1 ))
    else
        for (( i = 1; i <= n; i++ )); do
            [[ ${lines[i]} == \#[[:space:]]#${when}[[:space:]]# ]] || continue
            for (( i = i + 1; i <= n; i++ )); do
                [[ -n ${lines[i]##[[:space:]]#} ]] || break
            done
            at=i
            break
        done
        if (( ! at )); then
            [[ -n ${lines[n]:-} ]] && lines+=("")
            lines+=("# $when")
            at=$(( $#lines + 1 ))
        fi
    fi

    lines[at,at-1]=("$row")
    local tmp=$MANIFEST.tmp.$$
    print -rl -- "${lines[@]}" >"$tmp"
    mv -- "$tmp" "$MANIFEST"
}

cmd_adopt() {
    (( $# >= 2 )) || die "usage: $PROG adopt [-y] [-t <dir>] [-w personal|work] <src> <path>..."
    local raw_src=$1
    shift
    local -a paths
    paths=("$@")

    load_env
    parse_manifest

    local src
    src=$(normalize_src "$raw_src")
    if [[ -z $src || $src == (.|..|../*|*/..|*/../*|/*) ]]; then
        die "<src> must be a directory inside $(display_path "$REPO"): $raw_src"
    fi

    local abs_tgt when spec
    local -i i rc=0 new_row=0
    manifest_find_src "$src" || rc=$?
    case $rc in
        0)
            abs_tgt=$REPLY
            when=$REPLY_WHEN
            if [[ -n $OPT_TARGET || -n $OPT_WHEN ]]; then
                die "--target and --when only apply to a new source; $src is already in $MANIFEST"
            fi
            ;;
        2) die "$src is a file row in $MANIFEST; adopt needs a directory source" ;;
        *) new_row=1 ;;
    esac

    local p
    local -a abs_paths
    abs_paths=()
    for p in "${paths[@]}"; do
        p=$(resolve_home_file "$p")
        [[ -e $p || -L $p ]] || die "not found: $(display_path "$p")"
        is_repo_path "$p" && die "$(display_path "$p") is inside the repo"
        [[ $p == $HOME_DIR ]] && die "refusing to adopt all of ~"
        abs_paths+=("$p")
    done

    local abs_src=$REPO/$src
    if (( new_row )); then
        for (( i = 1; i <= $#MAN_SRC; i++ )); do
            [[ $MAN_KIND[i] == dir ]] || continue
            spec=$(normalize_src "$MAN_SRC[i]")
            if [[ $src == $spec/* || $spec == $src/* ]]; then
                die "$src overlaps manifest source $spec/; adopt into $spec instead"
            fi
        done
        if [[ -L $abs_src || ( -e $abs_src && ! -d $abs_src ) ]]; then
            die "$src exists in the repo and is not a directory"
        fi
        local -a existing
        existing=($abs_src/*(DN))
        if (( $#existing )); then
            die "$src/ already exists in the repo but is not in $MANIFEST; add a row for it first"
        fi

        if [[ -n $OPT_TARGET ]]; then
            abs_tgt=$(resolve_home_file "$OPT_TARGET")
        elif (( $#abs_paths == 1 )) && [[ -d $abs_paths[1] && ! -L $abs_paths[1] ]]; then
            abs_tgt=$abs_paths[1]
        else
            abs_tgt=${abs_paths[1]:h}
            for p in $abs_paths; do
                [[ ${p:h} == $abs_tgt ]] || die "paths have different parents; pass --target <dir> for new source $src"
            done
        fi
        if [[ $abs_tgt != $HOME_DIR && $abs_tgt != $HOME_DIR/* ]]; then
            die "target must be under ~: $(display_path "$abs_tgt")"
        fi
        when=$OPT_WHEN
    fi

    if ! profile_matches "$when"; then
        die "$src is when:$when but this machine's profile is ${DOTFILES_ENV:-unset}; the adopted links would be leftovers that prune removes"
    fi

    # Targets of other directory rows nested inside this one belong to
    # those sources; a walk must not sweep them into <src>.
    local t
    typeset -g -a INNER_SRC INNER_TGT
    INNER_SRC=()
    INNER_TGT=()
    for (( i = 1; i <= $#MAN_SRC; i++ )); do
        [[ $MAN_KIND[i] == dir ]] || continue
        t=$(abs_path "$MAN_TGT[i]")
        t=${t%/}
        [[ $t == $abs_tgt/* ]] || continue
        INNER_SRC+=("$(normalize_src "$MAN_SRC[i]")")
        INNER_TGT+=("$t")
    done

    # Expand paths to (home file, repo dest) pairs.
    local f rel dest
    local -a cand_home cand_dest
    typeset -A seen warned
    cand_home=()
    cand_dest=()
    seen=()
    warned=()
    for p in $abs_paths; do
        if [[ $p != $abs_tgt/* && ! ( -d $p && $p == $abs_tgt ) ]]; then
            die "$(display_path "$p") is not inside $(display_path "$abs_tgt") (target of $src)"
        fi
        if [[ ! -L $p ]] && inner_owner "$p"; then
            die "$(display_path "$p") is under $(display_path "$REPLY_TGT")/, the target of $REPLY/; adopt into that source"
        fi
        if [[ -L $p ]]; then
            die "$(display_path "$p") is a symlink; adopt regular files or directories"
        elif [[ -d $p ]]; then
            while IFS= read -r f; do
                [[ -n $f ]] || continue
                inner_owner "$f" && continue
                dest=$(resolve_link "$f") || dest=""
                is_repo_path "$dest" || warn "skipping symlink $(display_path "$f")"
            done < <(find "$p" \( -name .git -type d -prune \) -o -type l -print)
            collect_dir_files "$p"
            for f in $REPLY_FILES; do
                rel=${f#$abs_tgt/}
                should_skip "$rel" && continue
                is_repo_path "$f" && continue
                if inner_owner "$f"; then
                    if [[ -z ${warned[$REPLY_TGT]:-} ]]; then
                        warned[$REPLY_TGT]=1
                        warn "skipping $(display_path "$REPLY_TGT")/ (target of $REPLY/; adopt into that source)"
                    fi
                    continue
                fi
                [[ -n ${seen[$f]:-} ]] && continue
                seen[$f]=1
                cand_home+=("$f")
                cand_dest+=("$abs_src/$rel")
            done
        elif [[ -f $p ]]; then
            rel=${p#$abs_tgt/}
            if should_skip "$rel"; then
                die "$(display_path "$p") matches a skip pattern (.DS_Store, *.swp, *.tmp, .git); create would not link it"
            fi
            [[ -n ${seen[$p]:-} ]] && continue
            seen[$p]=1
            cand_home+=("$p")
            cand_dest+=("$abs_src/$rel")
        else
            die "$(display_path "$p") is not a regular file or directory"
        fi
    done
    (( $#cand_home )) || die "nothing to adopt"

    # Check every file before moving any.
    PLAN_QUIET=1
    build_plan 1
    PLAN_QUIET=0
    typeset -A planned
    planned=()
    for (( i = 1; i <= $#PLAN_TGT; i++ )); do
        planned[$PLAN_TGT[i]]=$PLAN_SRC[i]
    done

    local -i problems=0
    for (( i = 1; i <= $#cand_home; i++ )); do
        f=$cand_home[i]
        dest=$cand_dest[i]
        if [[ -e $dest || -L $dest ]]; then
            err "destination already exists: ${dest#$REPO/}"
            problems+=1
        elif [[ -n ${planned[$f]:-} ]]; then
            err "$(display_path "$f") is already provided by ${planned[$f]#$REPO/}"
            problems+=1
        fi
    done
    (( problems == 0 )) || die "adopted nothing: $problems problem(s)"

    local row_tgt
    row_tgt=$(display_path "$abs_tgt")/
    if (( ! DRY_RUN && ! OPT_YES && $#cand_home > 20 )); then
        [[ -t 0 ]] || die "$#cand_home files to adopt; rerun with -n to review, then -y to confirm"
        for f in "${(@)cand_home[1,10]}"; do
            print "  $(display_path "$f")"
        done
        print "  ... and $(( $#cand_home - 10 )) more"
        local reply=""
        read -r "reply?adopt $#cand_home files into $src/? [y/N] " || reply=""
        [[ $reply == (y|Y|yes|YES) ]] || die "adopted nothing"
    fi
    if (( DRY_RUN )); then
        (( new_row )) && print "would add row: $src/ $row_tgt${when:+ when:$when}"
        for (( i = 1; i <= $#cand_home; i++ )); do
            print "would adopt $(display_path "$cand_home[i]") -> ${cand_dest[i]#$REPO/}"
        done
        print "dry-run: $#cand_home file(s) to adopt"
        return 0
    fi

    if (( new_row )); then
        manifest_add_row "$src/" "$row_tgt" "$when"
        print "added row: $src/ $row_tgt${when:+ when:$when}"
    fi
    for (( i = 1; i <= $#cand_home; i++ )); do
        f=$cand_home[i]
        dest=$cand_dest[i]
        mkdir -p -- "${dest:h}"
        mv -- "$f" "$dest"
        if ! ln -s -- "$dest" "$f"; then
            mv -- "$dest" "$f"
            die "could not link $(display_path "$f"); restored it"
        fi
        print "adopted $(display_path "$f") -> ${dest#$REPO/}"
    done

    PLAN_QUIET=1
    build_plan 0
    write_last_plan
    print "adopted $#cand_home file(s)"
}

# Sets REPLY to the source spec and REPLY_TGT to the target of the nested
# directory row (INNER_*) whose target contains path $1.
inner_owner() {
    local p=$1
    local -i j
    for (( j = 1; j <= $#INNER_TGT; j++ )); do
        if [[ $p == $INNER_TGT[j] || $p == $INNER_TGT[j]/* ]]; then
            REPLY=$INNER_SRC[j]
            REPLY_TGT=$INNER_TGT[j]
            return 0
        fi
    done
    return 1
}

# Dies if the command was given a flag it does not take.
check_opts() {
    local cmd=$1
    shift
    local -a allow
    allow=("$@")
    if (( SHOW_ALL )) && (( ! ${allow[(Ie)-a]} )); then
        die "$cmd does not take -a"
    fi
    if [[ -n $OPT_TARGET ]] && (( ! ${allow[(Ie)-t]} )); then
        die "$cmd does not take --target"
    fi
    if [[ -n $OPT_WHEN ]] && (( ! ${allow[(Ie)-w]} )); then
        die "$cmd does not take --when"
    fi
    if (( OPT_YES )) && (( ! ${allow[(Ie)-y]} )); then
        die "$cmd does not take --yes"
    fi
}

# --- main ---

typeset -a pos shift_args
typeset -i end_opts=0
pos=()
while (( $# )); do
    if (( end_opts )); then
        pos+=("$1")
        shift
        continue
    fi
    case $1 in
        --) end_opts=1 ;;
        -n|--dry-run) DRY_RUN=1 ;;
        -a|--all) SHOW_ALL=1 ;;
        -y|--yes) OPT_YES=1 ;;
        -t|--target)
            (( $# >= 2 )) || die "$1 needs a directory"
            OPT_TARGET=$2
            shift
            ;;
        -w|--when)
            (( $# >= 2 )) || die "$1 needs personal or work"
            [[ $2 == personal || $2 == work ]] || die "invalid --when ${(q)2} (expected personal or work)"
            OPT_WHEN=$2
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        -?*)
            die "unknown flag $1 (run '$PROG --help')"
            ;;
        *)
            pos+=("$1")
            ;;
    esac
    shift
done

(( $#pos >= 1 )) || { usage >&2; exit 2 }

cmd=$pos[1]
shift_args=("${pos[@]:1}")

case $cmd in
    create) check_opts create;       cmd_create "${shift_args[@]}" ;;
    status) check_opts status -a;    cmd_status "${shift_args[@]}" ;;
    adopt)  check_opts adopt -t -w -y; cmd_adopt  "${shift_args[@]}" ;;
    prune)  check_opts prune;        cmd_prune  "${shift_args[@]}" ;;
    *)
        die "unknown command $cmd (run '$PROG --help')"
        ;;
esac
